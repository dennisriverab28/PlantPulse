# Backend — copy to backend/.env for local development outside Docker.
# Defaults to a local SQLite file if unset, so the app runs with zero setup.
DATABASE_URL=postgresql+psycopg://plantpulse:plantpulse@localhost:5432/plantpulse
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=5
CORS_ORIGINS=http://localhost:5173

# Slice 4 — AI copilot
ANTHROPIC_API_KEY=
